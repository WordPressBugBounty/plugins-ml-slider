#: admin/assets/dist/js/app.js:2
msgid "Find out more about MetaSlider Slideshow Pro"
msgstr "Saznajte više o MetaSlider Slideshow Pro"

#: ml-slider.php:2070
msgid "Create slideshows with your Vimeo videos"
msgstr "Kreirajte slajdove s vašim Vimeo videozapisima"

#: ml-slider.php:2074
msgid ""
"With Vimeo slides, you can build beautiful slideshows with your Vimeo "
"videos."
msgstr ""
"Sa Vimeo slajdovima možete izraditi prekrasne slajdove s vašim Vimeo "
"videozapisima."

#: ml-slider.php:2078
msgid ""
"Vimeo slides will display your videos with auto play, mute, the ability to "
"hide controls, and much more."
msgstr ""
"Vimeo slajdovi će prikazivati vaše videozapise s automatskim reprodukcijom, "
"isključenim zvukom, mogućnošću skrivanja kontrola i još mnogo toga."

#: ml-slider.php:2111
msgid "Create slideshows with your YouTube videos"
msgstr "Kreirajte slajdove s vašim YouTube videozapisima"

#: ml-slider.php:2115
msgid ""
"With YouTube slides, you can build beautiful slideshows with your YouTube "
"videos."
msgstr ""
"Sa YouTube slajdovima možete izraditi prekrasne slajdove s vašim YouTube "
"videozapisima."

#: ml-slider.php:2119
msgid ""
"YouTube slides will display your videos with auto play, mute, lazy load, "
"the ability to hide controls, and much more."
msgstr ""
"YouTube slajdovi će prikazivati vaše videozapise s automatskim "
"reprodukcijom, isključenim zvukom, odgodom učitavanja, mogućnošću skrivanja "
"kontrola i još mnogo toga."

#: ml-slider.php:2152
msgid "Create slideshows with your posts"
msgstr "Kreirajte slajdove s vašim objavama"

#: ml-slider.php:2156
msgid ""
"With Post Feed slides, you can build slideshows with your latest posts, "
"events, or WooCommerce products."
msgstr ""
"S Post Feed slajdovima možete izraditi slajdove s vašim najnovijim "
"postovima, događanjima ili WooCommerce proizvodima."

#: ml-slider.php:2160
msgid ""
"Post Feed slides will automatically display your posts with images, text, "
"custom fields, and much more."
msgstr ""
"Post Feed slajdovi automatski će prikazivati vaše postove s slikama, "
"tekstom, prilagođenim poljima i još mnogo toga."

#: ml-slider.php:2195
msgid "Create slideshows with images stored outside of WordPress"
msgstr "Izradite slajdove s slikama pohranjenim izvan WordPress-a"

#: ml-slider.php:2199
msgid ""
"With External URL slides, you can load images directly from non-WordPress "
"sources such as CDNs or image hosts."
msgstr ""
"S External URL slajdovima možete učitati slike izravno iz ne-WordPress "
"izvora kao što su CDN-ovi ili hostovi slika."

#: ml-slider.php:2203
msgid ""
"External URL slides give you all the power of MetaSlider Slideshow, using "
"images stored anywhere you want."
msgstr ""
"External URL slajdovi daju vam svu moć MetaSlider Slideshow-a, koristeći "
"slike pohranjene gdje god želite."

#: ml-slider.php:2238
msgid "Create slideshows with videos in your media library"
msgstr "Izradite slajdove s videozapisima u vašoj biblioteci medija"

#: ml-slider.php:2242
msgid ""
"With Local Video slides, you can build beautiful slideshows with videos in "
"your WordPress media library."
msgstr ""
"S Local Video slajdovima možete izraditi prekrasne slajdove s videozapisima "
"u vašoj WordPress biblioteci medija."

#: ml-slider.php:2246
msgid ""
"Local Video slides will display your MP4, WebM, and MOV videos with cover "
"images, auto play, mute, lazy load, the ability to hide controls, and much "
"more."
msgstr ""
"Local Video slajdovi će prikazivati vaše MP4, WebM i MOV videozapise s "
"naslovnim slikama, automatskim reprodukcijama, isključenim zvukom, lenjom "
"učitavanjem, mogućnošću skrivenja kontrola i još mnogo toga."

#: ml-slider.php:2281
msgid "Create slideshows with videos stored outside of WordPress"
msgstr "Izradite slajdove s videozapisima pohranjenim izvan WordPress-a"

#: ml-slider.php:2285
msgid ""
"With External Video slides, you can add videos directly from non-WordPress "
"sources."
msgstr ""
"S External Video slajdovima možete dodati videozapise izravno iz "
"ne-WordPress izvora."

#: ml-slider.php:2289
msgid ""
"External Video Slides will display your MP4, WebM, and MOV videos. Features "
"include text captions, cover images, auto play, mute, lazy load, the "
"ability to hide controls, and much more."
msgstr ""
"External Video slajdovi će prikazivati vaše MP4, WebM i MOV videozapise. "
"Značajke uključuju tekstualne natpise, naslovne slike, automatsku "
"reprodukciju, isključen zvuk, lenjo učitavanje, mogućnost skrivenja "
"kontrola i još mnogo toga."

#: ml-slider.php:2324
msgid "Create slideshows with custom HTML"
msgstr "Izradite slajdove s prilagođenim HTML-om"

#: ml-slider.php:2328
msgid ""
"With Custom HTML slides, you can design slides using images, HTML and CSS. "
"This gives you complete control over the layout and styling."
msgstr ""
"S Custom HTML slajdovima možete dizajnirati slajdove koristeći slike, HTML "
"i CSS. To vam daje potpunu kontrolu nad rasporedom i stiliziranjem."

#: ml-slider.php:2367
msgid "Create slides with background colors and text"
msgstr "Izradite slajdove s pozadinskim bojama i tekstom"

#: ml-slider.php:2371
msgid ""
"With Background Color slides, you can create slides using a solid or "
"gradient background color. Perfect for text-only slides, calls to action or "
"quick banners."
msgstr ""
"S Background Color slajdovima možete izraditi slajdove koristeći solidnu "
"ili gradijentnu pozadinsku boju. Savršeno za slajdove samo s tekstom, "
"pozive na akciju ili brze bannere."

#: ml-slider.php:2406
msgid "Create slideshows with Tiktok Videos"
msgstr "Izradite slajdove s TikTok videozapisima"

#: ml-slider.php:2410
msgid ""
"A TikTok Slide will display a video in your slideshow directly from "
"TikTok.com."
msgstr "TikTok slajd će prikazati videozapis u vašem slajdu izravno s TikTok.com."

#: ml-slider.php:2473
msgid "Create slideshows with images from a folder"
msgstr "Izradite slajdove s slikama iz mape"

#: ml-slider.php:2477
msgid ""
"The Image Folder slide type extracts images from a specified folder and "
"displays them as slides."
msgstr ""
"Tip slajda Image Folder izvlači slike iz određene mape i prikazuje ih kao "
"slajdove."

#: ml-slider.php:2481
msgid ""
"This slide type displays images from folders in your WordPress Media "
"Library."
msgstr "Ovaj tip slajda prikazuje slike iz mapa u vašoj WordPress biblioteci medija."

#: ml-slider.php:2508
msgid "Create slideshows with Post Images"
msgstr "Kreirajte slideshow-e s Post slikama"

#: ml-slider.php:2512
msgid ""
"The Post Images slide type extracts images from the current post and "
"displays them as slides."
msgstr ""
"Tip slajda Post slike izvlači slike iz trenutnog posta i prikazuje ih kao "
"slajdove."

#: ml-slider.php:2516
msgid ""
"This slide type supports featured images, post content images, WooCommerce "
"galleries, Advanced Custom Fields images and galleries."
msgstr ""
"Ovaj tip slajda podržava istaknute slike, slike sadržaja posta, WooCommerce "
"galerije, slike i galerije naprednih prilagođenih polja."

#: ml-slider.php:2543
msgid "Create slideshows with your WooCommerce products"
msgstr "Kreirajte slideshow-e s vašim WooCommerce proizvodima"

#: ml-slider.php:2547
msgid ""
"With WooCommerce slides, you can build slideshows with your WooCommerce "
"products."
msgstr ""
"S WooCommerce slajdovima možete izgraditi slideshow-e s vašim WooCommerce "
"proizvodima."

#: ml-slider.php:2551
msgid ""
"WooCommerce slides will automatically display your products with images, "
"text, custom fields, and much more."
msgstr ""
"WooCommerce slajdovi automatski će prikazati vaše proizvode sa slikama, "
"tekstom, prilagođenim poljima i još mnogo toga."

#: ml-slider.php:2595
msgid "Premium Support"
msgstr "Premium podrška"

#: ml-slider.php:2601
msgid "MetaSlider Slideshow Pro"
msgstr "MetaSlider Slideshow Pro"

#: ml-slider.php:2605
msgid "Support"
msgstr "Podrška"

#: ml-slider.php:2610
msgid "Documentation"
msgstr "Dokumentacija"

#: ml-slider.php:2614
msgid "Leave a review"
msgstr "Ostavite recenziju"

#: ml-slider.php:2733
msgid "Uploading..."
msgstr "Učitavanje..."

#: ml-slider.php:2740
msgid "Upload Complete"
msgstr "Učitavanje završeno"

#: ml-slider.php:2865
msgid "Import file is missing"
msgstr "Datoteka za uvoz nedostaje"

